---
import { ArrowUpRight, Github, ExternalLink } from 'lucide-react';
---

<footer class="bg-[#050505] border-t border-gray-900 mt-auto">
  
  {/* Agency Service CTA Banner (marketing-skills.com reference style) */}
  <div className="border-b border-gray-900 bg-[#0A0A0A] py-12 px-4 sm:px-6 lg:px-8 text-center">
    <div className="max-w-4xl mx-auto">
      <div className="inline-flex items-center gap-2 px-3 py-1 mb-4 text-[10px] font-mono text-orange-400 border border-orange-900/50 bg-orange-900/10 rounded-full">
        WANT COMMERCE OS BUILT FOR YOUR BUSINESS?
      </div>

      <h3 className="text-2xl sm:text-3xl font-extrabold text-white tracking-tight mb-3">
        We replace legacy software with <span className="text-orange-500">Autonomous Agentic Systems.</span>
      </h3>

      <p className="text-sm text-gray-400 max-w-xl mx-auto mb-6 leading-relaxed">
        Book a 15-minute architecture review. We will dissect your stack, dark store flows, and fleet logistics — and show you where the money is escaping.
      </p>

      <div className="flex flex-wrap justify-center gap-4">
        <a 
          href="https://www.vridhilabs.com/#book-audit" 
          target="_blank" 
          rel="noopener noreferrer"
          className="bg-white text-black px-6 py-3 rounded-lg font-bold text-xs hover:bg-orange-500 hover:text-white transition inline-flex items-center gap-2"
        >
          Book Architecture Audit <ArrowUpRight className="w-4 h-4" />
        </a>
        <a 
          href="https://www.vridhilabs.com/systems" 
          target="_blank" 
          rel="noopener noreferrer"
          className="px-6 py-3 rounded-lg text-xs font-bold text-white border border-gray-800 hover:border-gray-600 transition inline-flex items-center gap-2"
        >
          Explore Systems <ExternalLink className="w-4 h-4 text-gray-500" />
        </a>
      </div>
    </div>
  </div>

  {/* Footer Credit & Links */}
  <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 text-center">
    <div className="flex flex-wrap justify-center items-center gap-x-6 gap-y-2 text-xs font-mono text-gray-400 mb-6">
      <span>Built by <a href="https://www.vridhilabs.com" target="_blank" class="text-orange-400 hover:underline font-bold">Vridhi Labs</a> (Agentic Partner)</span>
      <span class="text-gray-700">•</span>
      <span>Published on <a href="https://www.npmjs.com/package/@vridhilabs/commerce-skills" target="_blank" class="text-cyan-400 hover:underline">NPM Registry</a></span>
      <span class="text-gray-700">•</span>
      <span>Open Source on <a href="https://github.com/vridhilabs/commerce-skills" target="_blank" class="text-white hover:underline">GitHub</a></span>
      <span class="text-gray-700">•</span>
      <span>Read <a href="https://newsletter.vridhilabs.com" target="_blank" class="text-orange-400 hover:underline">The Dispatch</a></span>
    </div>

    <div class="text-[11px] text-gray-600 font-mono">
      © 2026 Vridhi Labs. Distributed under the MIT License.
    </div>
  </div>

</footer>
