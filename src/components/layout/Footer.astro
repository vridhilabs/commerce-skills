---
import { Github } from 'lucide-react';
---

<footer class="border-t border-border/40 bg-background/50 py-12 mt-auto">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <div class="flex items-center justify-center gap-2 mb-4">
      <div class="w-7 h-7 rounded-lg bg-gradient-to-br from-violet-600 to-cyan-500 flex items-center justify-center font-bold text-white text-xs">
        CS
      </div>
      <span class="font-extrabold text-white text-sm">Commerce Skills OS</span>
    </div>
    
    <p class="text-xs text-muted-foreground max-w-md mx-auto mb-6">
      Open-Source AI Agent Skill Suite for Commerce OS, Quick-Commerce, Hyperlocal Logistics, B2B Procurement, and Multi-Tenant E-Commerce.
    </p>

    <div class="flex justify-center items-center gap-6 text-xs text-muted-foreground mb-8">
      <a href="https://github.com/vridhilabs/commerce-skills" class="hover:text-white transition-colors flex items-center gap-1">
        <Github class="w-3.5 h-3.5" /> GitHub
      </a>
      <span>•</span>
      <a href="#skills" class="hover:text-white transition-colors">Catalog</a>
      <span>•</span>
      <a href="#architecture" class="hover:text-white transition-colors">Architecture</a>
      <span>•</span>
      <a href="#verticals" class="hover:text-white transition-colors">Verticals</a>
    </div>

    <div class="text-[11px] text-muted-foreground/60 font-mono">
      Built with Astro 5 • Tailwind CSS • React • shadcn/ui • MIT License
    </div>
  </div>
</footer>
